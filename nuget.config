<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    BouncyCastle.Cryptography is a patched fork (github.com/feiudfyg/bc-csharp,
    branch kasumi-v5v6) that adds GnuPG v5 (crypto-refresh draft) support.
    The package is vendored under third_party/nuget so the project builds
    without access to the fork repository.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="kasumi-fork" value="third_party/nuget" />
  </packageSources>
</configuration>
