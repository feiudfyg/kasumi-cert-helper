<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="KasumiCertHelper.Views.GpgPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:KasumiCertHelper.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ===================== toolbar ===================== -->
        <Border Grid.Row="0" Padding="12,8,12,6" BorderThickness="0,0,0,1"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <Grid ColumnSpacing="10" RowSpacing="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="{x:Bind T('Gpg_Toolbar_KeyGroup')}" Style="{StaticResource ToolbarGroupCaptionStyle}" />
                <ScrollViewer Grid.Row="0" Grid.Column="1" HorizontalScrollBarVisibility="Auto"
                              HorizontalScrollMode="Auto" VerticalScrollBarVisibility="Disabled">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="RefreshButton" Click="OnRefreshClick">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE72C;" FontSize="14" />
                                <TextBlock Text="{x:Bind T('Common_Refresh')}" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="GenerateButton" Click="OnGenerateClick">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE710;" FontSize="14" />
                                <TextBlock Text="{x:Bind T('Gpg_Generate')}" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="ImportButton" Click="OnImportClick">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE8B5;" FontSize="14" />
                                <TextBlock Text="{x:Bind T('Gpg_Import')}" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="DeleteButton" Click="OnDeleteClick">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE74D;" FontSize="14" />
                                <TextBlock Text="{x:Bind T('Gpg_DeleteKey')}" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="OpenKeyFolderButton" Click="OnManageKeysClick">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE8B7;" FontSize="14" />
                                <TextBlock Text="{x:Bind T('Gpg_OpenKeyFolder')}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
                <ProgressRing x:Name="BusyRing" Grid.Row="0" Grid.Column="2" IsActive="False" Width="20" Height="20"
                              VerticalAlignment="Center" />

                <TextBlock Grid.Row="1" Grid.Column="0" Text="{x:Bind T('Gpg_Toolbar_ExportGroup')}" Style="{StaticResource ToolbarGroupCaptionStyle}" />
                <ScrollViewer Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" HorizontalScrollBarVisibility="Auto"
                              HorizontalScrollMode="Auto" VerticalScrollBarVisibility="Disabled">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="ExportPublicButton" Click="OnExportPublicClick">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE898;" FontSize="14" />
                                <TextBlock Text="{x:Bind T('Gpg_ExportPublic')}" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="ExportSecretButton" Click="OnExportSecretClick">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE72E;" FontSize="14" />
                                <TextBlock Text="{x:Bind T('Gpg_ExportSecret')}" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="CopyFingerprintButton" Click="OnCopyFingerprintClick">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE8C8;" FontSize="14" />
                                <TextBlock Text="{x:Bind T('Gpg_CopyFingerprint')}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="{x:Bind T('Gpg_Toolbar_FileGroup')}" Style="{StaticResource ToolbarGroupCaptionStyle}" />
                <ScrollViewer Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" HorizontalScrollBarVisibility="Auto"
                              HorizontalScrollMode="Auto" VerticalScrollBarVisibility="Disabled">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="EncryptButton" Click="OnEncryptClick">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE72E;" FontSize="14" />
                                <TextBlock Text="{x:Bind T('Gpg_EncryptFile')}" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="DecryptButton" Click="OnDecryptClick">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE785;" FontSize="14" />
                                <TextBlock Text="{x:Bind T('Gpg_DecryptFile')}" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="SignButton" Click="OnSignClick">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE70F;" FontSize="14" />
                                <TextBlock Text="{x:Bind T('Gpg_SignFile')}" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="VerifyButton" Click="OnVerifyClick">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE8FB;" FontSize="14" />
                                <TextBlock Text="{x:Bind T('Gpg_VerifyFile')}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- ===================== content ===================== -->
        <Grid x:Name="ContentGrid" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="520" MinWidth="280" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="260" />
            </Grid.ColumnDefinitions>

            <!-- Key list -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Padding="12,12,12,8" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{x:Bind T('Gpg_PaneTitle')}" Style="{StaticResource PaneTitleStyle}" />
                    <ComboBox x:Name="FilterBox" Grid.Column="1" MinWidth="120" SelectionChanged="OnFilterChanged">
                        <ComboBoxItem Content="{x:Bind T('Gpg_FilterAll')}" />
                        <ComboBoxItem Content="{x:Bind T('Gpg_FilterSecret')}" />
                        <ComboBoxItem Content="{x:Bind T('Gpg_FilterPublic')}" />
                    </ComboBox>
                    <TextBlock x:Name="CountText" Grid.Column="2" VerticalAlignment="Center" FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Grid>

                <TextBox x:Name="SearchBox" Grid.Row="1" Margin="12,0,12,8"
                         PlaceholderText="{x:Bind T('Gpg_SearchPlaceholder')}" TextChanged="OnSearchTextChanged" />

                <Grid Grid.Row="2" Padding="12,4,8,4" ColumnSpacing="10" BorderThickness="0,1,0,1"
                      BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{x:Bind Columns.W0, Mode=OneWay, Converter={StaticResource PxWidth}}" />
                        <ColumnDefinition Width="{x:Bind Columns.W1, Mode=OneWay, Converter={StaticResource PxWidth}}" />
                        <ColumnDefinition Width="{x:Bind Columns.W2, Mode=OneWay, Converter={StaticResource PxWidth}}" />
                        <ColumnDefinition Width="{x:Bind Columns.W3, Mode=OneWay, Converter={StaticResource PxWidth}}" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="KeyHeaderName" Grid.Column="0" Text="{x:Bind T('Gpg_HeaderName')}" Style="{StaticResource TableHeaderTextStyle}" />
                    <TextBlock x:Name="KeyHeaderAlgorithm" Grid.Column="1" Text="{x:Bind T('Gpg_HeaderAlgorithm')}" Style="{StaticResource TableHeaderTextStyle}" />
                    <TextBlock x:Name="KeyHeaderExpires" Grid.Column="2" Text="{x:Bind T('Gpg_HeaderExpires')}" Style="{StaticResource TableHeaderTextStyle}" />
                    <TextBlock x:Name="KeyHeaderSecret" Grid.Column="3" Text="{x:Bind T('Gpg_HeaderSecret')}" Style="{StaticResource TableHeaderTextStyle}" />

                    <Border Grid.Column="0" Style="{StaticResource ColumnResizerStyle}" Tag="0"
                            ManipulationDelta="OnColumnResize" ToolTipService.ToolTip="{x:Bind T('Common_DragToResizeColumn')}" />
                    <Border Grid.Column="1" Style="{StaticResource ColumnResizerStyle}" Tag="1"
                            ManipulationDelta="OnColumnResize" ToolTipService.ToolTip="{x:Bind T('Common_DragToResizeColumn')}" />
                    <Border Grid.Column="2" Style="{StaticResource ColumnResizerStyle}" Tag="2"
                            ManipulationDelta="OnColumnResize" ToolTipService.ToolTip="{x:Bind T('Common_DragToResizeColumn')}" />
                    <Border Grid.Column="3" Style="{StaticResource ColumnResizerStyle}" Tag="3"
                            ManipulationDelta="OnColumnResize" ToolTipService.ToolTip="{x:Bind T('Common_DragToResizeColumn')}" />
                </Grid>

                <Grid x:Name="KeyListHost" Grid.Row="3" SizeChanged="OnTableSizeChanged">
                    <ListView x:Name="KeyList" SelectionMode="Single"
                              ItemContainerStyle="{StaticResource TableRowItemStyle}"
                              SelectionChanged="OnKeySelectionChanged"
                              RightTapped="OnKeyRightTapped">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:GpgRow">
                                <Grid ColumnSpacing="10" Padding="0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{x:Bind Columns.W0, Mode=OneWay, Converter={StaticResource PxWidth}}" />
                                        <ColumnDefinition Width="{x:Bind Columns.W1, Mode=OneWay, Converter={StaticResource PxWidth}}" />
                                        <ColumnDefinition Width="{x:Bind Columns.W2, Mode=OneWay, Converter={StaticResource PxWidth}}" />
                                        <ColumnDefinition Width="{x:Bind Columns.W3, Mode=OneWay, Converter={StaticResource PxWidth}}" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid Grid.Column="0" ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Glyph="&#xE192;" FontSize="14" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{x:Bind PrimaryUserId}" Style="{StaticResource TableCellTextStyle}" />
                                            <TextBlock Text="{x:Bind ShortFingerprint}" FontSize="11" FontFamily="Consolas"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Grid.Column="1" Text="{x:Bind AlgorithmText}"
                                               Style="{StaticResource TableCellTextStyle}" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind ExpiresText}"
                                               Style="{StaticResource TableCellTextStyle}" />
                                    <TextBlock Grid.Column="3" Text="{x:Bind SecretText}"
                                               Style="{StaticResource TableCellTextStyle}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <StackPanel x:Name="KeyEmptyState" Visibility="Collapsed" IsHitTestVisible="False"
                                HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" MaxWidth="280">
                        <FontIcon Glyph="&#xE192;" FontSize="28"
                                  Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <TextBlock x:Name="KeyEmptyText" Text="{x:Bind T('Gpg_EmptyKeys')}" TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Grid>
            </Grid>

            <Border Grid.Column="1" Style="{StaticResource PaneSplitterStyle}"
                    ManipulationDelta="OnKeyPaneSplitterDrag">
                <Border Width="1" HorizontalAlignment="Center"
                        Background="{ThemeResource CardStrokeColorDefaultBrush}" />
            </Border>

            <!-- Key details -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Padding="12,12,12,8" Spacing="2">
                    <TextBlock x:Name="DetailTitle" Style="{StaticResource PaneTitleStyle}"
                               TextWrapping="Wrap" Text="{x:Bind T('Gpg_DetailsTitle')}" />
                    <TextBlock x:Name="DetailStatusText" FontSize="12" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <ScrollViewer Grid.Row="1" Padding="12,0,12,12" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="DetailPanel" Spacing="4" />
                </ScrollViewer>

                <StackPanel x:Name="DetailEmptyState" Grid.Row="1" HorizontalAlignment="Center"
                            VerticalAlignment="Center" Spacing="8" MaxWidth="280" IsHitTestVisible="False">
                    <FontIcon Glyph="&#xE946;" FontSize="28"
                              Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <TextBlock Text="{x:Bind T('Gpg_DetailsEmptyHint')}" TextWrapping="Wrap"
                               TextAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Page>
