<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="KasumiCertHelper.Views.StoresPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:KasumiCertHelper.Core.Models"
    xmlns:vm="using:KasumiCertHelper.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ===================== toolbar ===================== -->
        <Border Grid.Row="0" Padding="12,8,12,6" BorderThickness="0,0,0,1"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <Grid ColumnSpacing="10" RowSpacing="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="{x:Bind T('Stores_Toolbar_StoreGroup')}" Style="{StaticResource ToolbarGroupCaptionStyle}" />
                <ScrollViewer Grid.Row="0" Grid.Column="1" HorizontalScrollBarVisibility="Auto"
                              HorizontalScrollMode="Auto" VerticalScrollBarVisibility="Disabled">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="RefreshButton" Click="OnRefreshClick">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE72C;" FontSize="14" />
                                <TextBlock Text="{x:Bind T('Common_Refresh')}" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="ImportButton" Click="OnImportClick">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE8B5;" FontSize="14" />
                                <TextBlock Text="{x:Bind T('Stores_ImportCertificate')}" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="ExportButton" Click="OnExportClick">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE898;" FontSize="14" />
                                <TextBlock Text="{x:Bind T('Stores_ExportSelected')}" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="DeleteButton" Click="OnDeleteClick">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE74D;" FontSize="14" />
                                <TextBlock Text="{x:Bind T('Stores_DeleteSelected')}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
                <ProgressRing x:Name="BusyRing" Grid.Row="0" Grid.Column="2" IsActive="False" Width="20" Height="20"
                              VerticalAlignment="Center" />

                <TextBlock Grid.Row="1" Grid.Column="0" Text="{x:Bind T('Stores_Toolbar_ClipboardGroup')}" Style="{StaticResource ToolbarGroupCaptionStyle}" />
                <ScrollViewer Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" HorizontalScrollBarVisibility="Auto"
                              HorizontalScrollMode="Auto" VerticalScrollBarVisibility="Disabled">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="CopyButton" Click="OnCopyClick">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE8C8;" FontSize="14" />
                                <TextBlock Text="{x:Bind T('Stores_CopyFingerprint')}" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="CopyDetailsButton" Click="OnCopyDetailsClick">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE8C8;" FontSize="14" />
                                <TextBlock Text="{x:Bind T('Stores_CopyDetails')}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="{x:Bind T('Stores_Toolbar_ToolsGroup')}" Style="{StaticResource ToolbarGroupCaptionStyle}" />
                <ScrollViewer Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" HorizontalScrollBarVisibility="Auto"
                              HorizontalScrollMode="Auto" VerticalScrollBarVisibility="Disabled">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="CertMgrButton" Click="OnOpenCertMgrClick">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE8A5;" FontSize="14" />
                                <TextBlock Text="{x:Bind T('Stores_OpenCertMgr')}" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="ElevateButton" Click="OnElevateClick">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE72E;" FontSize="14" />
                                <TextBlock Text="{x:Bind T('Common_RestartElevated')}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <InfoBar x:Name="StatusBar" Grid.Row="1" IsOpen="False" Severity="Error" IsClosable="True" Margin="8,4" />

        <!-- ===================== content ===================== -->
                <Grid x:Name="ContentGrid" Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="StorePaneColumn" Width="230" MinWidth="160" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" MinWidth="300" />
                    </Grid.ColumnDefinitions>

            <!-- Store tree -->
            <Grid Grid.Column="0" Padding="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{x:Bind T('Stores_PaneTitle')}" Style="{StaticResource PaneTitleStyle}" />
                    <TextBlock x:Name="StoreCountText" VerticalAlignment="Center" FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <TextBox x:Name="StoreSearchBox" Grid.Row="1" Margin="0,8,0,8"
                         PlaceholderText="{x:Bind T('Stores_FilterStores')}" TextChanged="OnStoreSearchChanged" />

                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                    <StackPanel Spacing="4">
                        <Expander x:Name="UserStoreExpander" Header="{x:Bind T('Store_Location_CurrentUser')}" IsExpanded="True"
                                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                            <ListView x:Name="UserStoreList" SelectionMode="Single"
                                      ItemContainerStyle="{StaticResource CompactRowItemStyle}"
                                      ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                      SelectionChanged="OnStoreSelectionChanged">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="models:StoreSummary">
                                        <Grid ColumnSpacing="8" Padding="0,5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{x:Bind DisplayName}"
                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind CountText}" FontSize="12"
                                                       VerticalAlignment="Center"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Expander>

                        <Expander x:Name="MachineStoreExpander" Header="{x:Bind T('Store_Location_LocalMachine')}" IsExpanded="True"
                                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                            <ListView x:Name="MachineStoreList" SelectionMode="Single"
                                      ItemContainerStyle="{StaticResource CompactRowItemStyle}"
                                      ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                      SelectionChanged="OnStoreSelectionChanged">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="models:StoreSummary">
                                        <Grid ColumnSpacing="8" Padding="0,5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{x:Bind DisplayName}"
                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind CountText}" FontSize="12"
                                                       VerticalAlignment="Center"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <Border Grid.Column="1" Style="{StaticResource PaneSplitterStyle}"
                    ManipulationDelta="OnStoreSplitterDrag">
                <Border Width="1" HorizontalAlignment="Center"
                        Background="{ThemeResource CardStrokeColorDefaultBrush}" />
            </Border>

            <!-- Certificate list and details -->
                <Grid x:Name="MainGrid" Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" MinHeight="120" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition x:Name="DetailsRow" Height="300" MinHeight="140" />
                    </Grid.RowDefinitions>

                <Grid Grid.Row="0" Padding="12,12,12,0" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="StoreTitleText" Grid.Column="0" Style="{StaticResource PaneTitleStyle}"
                               Text="{x:Bind T('Stores_SelectedStorePlaceholder')}" />
                    <Button x:Name="DetailsToggleButton" Grid.Column="1" Click="OnToggleDetailsClick"
                            Padding="8,3" MinWidth="0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon x:Name="DetailsToggleIcon" Glyph="&#xE70D;" FontSize="12" />
                            <TextBlock x:Name="DetailsToggleText" Text="{x:Bind T('Stores_HideDetails')}" FontSize="12" />
                        </StackPanel>
                    </Button>
                </Grid>

                <Grid Grid.Row="1" Padding="12,8,12,8" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="SearchBox" PlaceholderText="{x:Bind T('Stores_SearchPlaceholder')}"
                             TextChanged="OnSearchTextChanged" />
                    <TextBlock x:Name="CertificateCountText" Grid.Column="1" VerticalAlignment="Center" FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Grid>

                <Grid Grid.Row="2" Padding="12,4,8,4" ColumnSpacing="10" BorderThickness="0,1,0,1"
                      BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{x:Bind Columns.W0, Mode=OneWay, Converter={StaticResource PxWidth}}" />
                        <ColumnDefinition Width="{x:Bind Columns.W1, Mode=OneWay, Converter={StaticResource PxWidth}}" />
                        <ColumnDefinition Width="{x:Bind Columns.W2, Mode=OneWay, Converter={StaticResource PxWidth}}" />
                        <ColumnDefinition Width="{x:Bind Columns.W3, Mode=OneWay, Converter={StaticResource PxWidth}}" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="CertHeaderSubject" Grid.Column="0" Text="{x:Bind T('Cert_Row_Subject')}" Style="{StaticResource TableHeaderTextStyle}" />
                    <TextBlock x:Name="CertHeaderIssuer" Grid.Column="1" Text="{x:Bind T('Cert_Row_Issuer')}" Style="{StaticResource TableHeaderTextStyle}" />
                    <TextBlock x:Name="CertHeaderNotAfter" Grid.Column="2" Text="{x:Bind T('Cert_Row_NotAfter')}" Style="{StaticResource TableHeaderTextStyle}" />
                    <TextBlock x:Name="CertHeaderStatus" Grid.Column="3" Text="{x:Bind T('Cert_Row_Status')}" Style="{StaticResource TableHeaderTextStyle}" />

                    <Border Grid.Column="0" Style="{StaticResource ColumnResizerStyle}" Tag="0"
                            ManipulationDelta="OnColumnResize" ToolTipService.ToolTip="{x:Bind T('Common_DragToResizeColumn')}" />
                    <Border Grid.Column="1" Style="{StaticResource ColumnResizerStyle}" Tag="1"
                            ManipulationDelta="OnColumnResize" ToolTipService.ToolTip="{x:Bind T('Common_DragToResizeColumn')}" />
                    <Border Grid.Column="2" Style="{StaticResource ColumnResizerStyle}" Tag="2"
                            ManipulationDelta="OnColumnResize" ToolTipService.ToolTip="{x:Bind T('Common_DragToResizeColumn')}" />
                    <Border Grid.Column="3" Style="{StaticResource ColumnResizerStyle}" Tag="3"
                            ManipulationDelta="OnColumnResize" ToolTipService.ToolTip="{x:Bind T('Common_DragToResizeColumn')}" />
                </Grid>

                <Grid x:Name="CertListHost" Grid.Row="3" SizeChanged="OnTableSizeChanged">
                    <ListView x:Name="CertList" SelectionMode="Single"
                              ItemContainerStyle="{StaticResource TableRowItemStyle}"
                              SelectionChanged="OnCertificateSelectionChanged"
                              RightTapped="OnCertificateRightTapped">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:CertRow">
                                <Grid ColumnSpacing="10" Padding="0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{x:Bind Columns.W0, Mode=OneWay, Converter={StaticResource PxWidth}}" />
                                        <ColumnDefinition Width="{x:Bind Columns.W1, Mode=OneWay, Converter={StaticResource PxWidth}}" />
                                        <ColumnDefinition Width="{x:Bind Columns.W2, Mode=OneWay, Converter={StaticResource PxWidth}}" />
                                        <ColumnDefinition Width="{x:Bind Columns.W3, Mode=OneWay, Converter={StaticResource PxWidth}}" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid Grid.Column="0" ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Glyph="&#xE8D7;" FontSize="14" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind DisplayName}"
                                                   Style="{StaticResource TableCellTextStyle}" />
                                    </Grid>
                                    <TextBlock Grid.Column="1" Text="{x:Bind IssuerCommonName}"
                                               Style="{StaticResource TableCellTextStyle}" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind NotAfterText}"
                                               Style="{StaticResource TableCellTextStyle}" />
                                    <TextBlock Grid.Column="3" Text="{x:Bind StatusText}"
                                               Style="{StaticResource TableCellTextStyle}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <StackPanel x:Name="CertEmptyState" Visibility="Collapsed" IsHitTestVisible="False"
                                HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" MaxWidth="280">
                        <FontIcon Glyph="&#xE8D7;" FontSize="28"
                                  Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <TextBlock x:Name="CertEmptyText" Text="{x:Bind T('Stores_EmptyCertificates')}" TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="4" Height="11">
                    <Border Height="1" VerticalAlignment="Center"
                            Background="{ThemeResource CardStrokeColorDefaultBrush}" />
                    <Border Height="3" Width="44" CornerRadius="2" VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Background="{ThemeResource ControlStrongStrokeColorDefaultBrush}" />
                    <Thumb x:Name="DetailsSplitter" Background="Transparent" IsTabStop="True"
                           AutomationProperties.AutomationId="DetailsSplitter"
                           ToolTipService.ToolTip="{x:Bind T('Stores_DragToResizeDetails')}"
                           DragDelta="OnDetailsSplitterDrag" KeyDown="OnDetailsSplitterKeyDown" />
                </Grid>

                <Grid x:Name="DetailsPane" Grid.Row="5" BorderThickness="0,1,0,0"
                      BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Padding="12,10,12,6" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock x:Name="DetailsHeader" Style="{StaticResource PaneTitleStyle}"
                                       TextWrapping="Wrap" Text="{x:Bind T('Stores_DetailsTitle')}" />
                            <TextBlock x:Name="DetailsStatusText" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <Button x:Name="CopyDetailsInlineButton" Grid.Column="1" Click="OnCopyDetailsClick"
                                ToolTipService.ToolTip="{x:Bind T('Stores_CopyDetails')}" Padding="8,4" MinWidth="0" VerticalAlignment="Top">
                            <FontIcon Glyph="&#xE8C8;" FontSize="14" />
                        </Button>
                    </Grid>

                    <ScrollViewer Grid.Row="1" Padding="12,0,12,12" VerticalScrollBarVisibility="Auto"
                                  AutomationProperties.AutomationId="DetailsPane">
                        <StackPanel x:Name="DetailsPanel" Spacing="4" />
                    </ScrollViewer>

                    <StackPanel x:Name="DetailsEmptyState" Grid.Row="1" HorizontalAlignment="Center"
                                VerticalAlignment="Center" Spacing="8" MaxWidth="300" IsHitTestVisible="False">
                        <FontIcon Glyph="&#xE946;" FontSize="28"
                                  Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <TextBlock Text="{x:Bind T('Stores_DetailsEmptyHint')}" TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Page>
