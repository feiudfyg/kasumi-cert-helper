<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="KasumiCertHelper.Views.X509Page"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:KasumiCertHelper.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ===================== toolbar ===================== -->
        <Border Grid.Row="0" Padding="12,8,12,6" BorderThickness="0,0,0,1"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <Grid ColumnSpacing="10" RowSpacing="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="{x:Bind T('X509_Toolbar_DatabaseGroup')}" Style="{StaticResource ToolbarGroupCaptionStyle}" />
                <ScrollViewer Grid.Row="0" Grid.Column="1" HorizontalScrollBarVisibility="Auto"
                              HorizontalScrollMode="Auto" VerticalScrollBarVisibility="Disabled">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="NewDbButton" Click="OnNewDatabaseClick">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE710;" FontSize="14" />
                                <TextBlock Text="{x:Bind T('X509_NewDatabase')}" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="OpenDbButton" Click="OnOpenDatabaseClick">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE8E5;" FontSize="14" />
                                <TextBlock Text="{x:Bind T('X509_OpenDatabase')}" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="CloseDbButton" Click="OnCloseDatabaseClick">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE711;" FontSize="14" />
                                <TextBlock Text="{x:Bind T('X509_CloseDatabase')}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
                <ProgressRing x:Name="BusyRing" Grid.Row="0" Grid.Column="2" IsActive="False" Width="20" Height="20"
                              VerticalAlignment="Center" />

                <TextBlock Grid.Row="1" Grid.Column="0" Text="{x:Bind T('X509_Toolbar_CreateGroup')}" Style="{StaticResource ToolbarGroupCaptionStyle}" />
                <ScrollViewer Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" HorizontalScrollBarVisibility="Auto"
                              HorizontalScrollMode="Auto" VerticalScrollBarVisibility="Disabled">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="NewKeyButton" Click="OnNewKeyClick">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE8D7;" FontSize="14" />
                                <TextBlock Text="{x:Bind T('X509_NewKey')}" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="NewCertButton" Click="OnNewCertificateClick">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE8D7;" FontSize="14" />
                                <TextBlock Text="{x:Bind T('X509_NewSelfSigned')}" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="NewCaButton" Click="OnNewCaClick">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE72E;" FontSize="14" />
                                <TextBlock Text="{x:Bind T('X509_NewCa')}" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="NewCsrButton" Click="OnNewCsrClick">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE8A5;" FontSize="14" />
                                <TextBlock Text="{x:Bind T('X509_NewCsr')}" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="SignCsrButton" Click="OnSignCsrClick">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE70F;" FontSize="14" />
                                <TextBlock Text="{x:Bind T('X509_SignCsr')}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="{x:Bind T('X509_Toolbar_ActionsGroup')}" Style="{StaticResource ToolbarGroupCaptionStyle}" />
                <ScrollViewer Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" HorizontalScrollBarVisibility="Auto"
                              HorizontalScrollMode="Auto" VerticalScrollBarVisibility="Disabled">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="ImportButton" Click="OnImportClick">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE8B5;" FontSize="14" />
                                <TextBlock Text="{x:Bind T('Common_Import')}" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="ExportButton" Click="OnExportClick">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE898;" FontSize="14" />
                                <TextBlock Text="{x:Bind T('Common_Export')}" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="DeleteButton" Click="OnDeleteClick">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE74D;" FontSize="14" />
                                <TextBlock Text="{x:Bind T('Common_Delete')}" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="PasswordButton" Click="OnChangePasswordClick">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE72E;" FontSize="14" />
                                <TextBlock Text="{x:Bind T('X509_ChangePassword')}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- ===================== content ===================== -->
        <Grid x:Name="ContentGrid" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="420" MinWidth="260" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="280" />
            </Grid.ColumnDefinitions>

            <!-- Database items -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Padding="12,12,12,8" Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock x:Name="DatabaseTitle" FontWeight="SemiBold" FontSize="15"
                                   TextTrimming="CharacterEllipsis" Text="{x:Bind T('X509_NoDatabase')}" />
                        <TextBlock x:Name="ItemCountText" VerticalAlignment="Center" FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <TextBlock x:Name="DatabaseSubtitle" FontSize="12" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="{x:Bind T('X509_NoDatabaseHint')}" />
                </StackPanel>

                <TextBox x:Name="ItemFilterBox" Grid.Row="1" Margin="12,0,12,8"
                         PlaceholderText="{x:Bind T('X509_FilterPlaceholder')}" TextChanged="OnItemFilterChanged" />

                <Grid Grid.Row="2" Padding="12,4,8,4" ColumnSpacing="10" BorderThickness="0,1,0,1"
                      BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{x:Bind Columns.W0, Mode=OneWay, Converter={StaticResource PxWidth}}" />
                        <ColumnDefinition Width="{x:Bind Columns.W1, Mode=OneWay, Converter={StaticResource PxWidth}}" />
                        <ColumnDefinition Width="{x:Bind Columns.W2, Mode=OneWay, Converter={StaticResource PxWidth}}" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="ItemHeaderName" Grid.Column="0" Text="{x:Bind T('X509_HeaderName')}" Style="{StaticResource TableHeaderTextStyle}" />
                    <TextBlock x:Name="ItemHeaderKind" Grid.Column="1" Text="{x:Bind T('X509_HeaderKind')}" Style="{StaticResource TableHeaderTextStyle}" />
                    <TextBlock x:Name="ItemHeaderStatus" Grid.Column="2" Text="{x:Bind T('Cert_Row_Status')}" Style="{StaticResource TableHeaderTextStyle}" />

                    <Border Grid.Column="0" Style="{StaticResource ColumnResizerStyle}" Tag="0"
                            ManipulationDelta="OnColumnResize" ToolTipService.ToolTip="{x:Bind T('Common_DragToResizeColumn')}" />
                    <Border Grid.Column="1" Style="{StaticResource ColumnResizerStyle}" Tag="1"
                            ManipulationDelta="OnColumnResize" ToolTipService.ToolTip="{x:Bind T('Common_DragToResizeColumn')}" />
                    <Border Grid.Column="2" Style="{StaticResource ColumnResizerStyle}" Tag="2"
                            ManipulationDelta="OnColumnResize" ToolTipService.ToolTip="{x:Bind T('Common_DragToResizeColumn')}" />
                </Grid>

                <Grid x:Name="ItemListHost" Grid.Row="3" SizeChanged="OnTableSizeChanged">
                    <ListView x:Name="ItemList" SelectionMode="Single"
                              ItemContainerStyle="{StaticResource TableRowItemStyle}"
                              SelectionChanged="OnItemSelectionChanged"
                              RightTapped="OnItemRightTapped">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:X509Row">
                                <Grid ColumnSpacing="10" Padding="0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{x:Bind Columns.W0, Mode=OneWay, Converter={StaticResource PxWidth}}" />
                                        <ColumnDefinition Width="{x:Bind Columns.W1, Mode=OneWay, Converter={StaticResource PxWidth}}" />
                                        <ColumnDefinition Width="{x:Bind Columns.W2, Mode=OneWay, Converter={StaticResource PxWidth}}" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid Grid.Column="0" ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Glyph="{x:Bind KindGlyph}" FontSize="14" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{x:Bind Name}" Style="{StaticResource TableCellTextStyle}" />
                                            <TextBlock Text="{x:Bind Subject}" FontSize="11"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Grid.Column="1" Text="{x:Bind KindText}"
                                               Style="{StaticResource TableCellTextStyle}" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind ValidityText}"
                                               Style="{StaticResource TableCellTextStyle}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <StackPanel x:Name="ItemEmptyState" Visibility="Collapsed" IsHitTestVisible="False"
                                HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" MaxWidth="260">
                        <FontIcon Glyph="&#xE8D7;" FontSize="28"
                                  Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <TextBlock x:Name="ItemEmptyText" Text="{x:Bind T('X509_EmptyItems')}" TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Grid>
            </Grid>

            <Border Grid.Column="1" Style="{StaticResource PaneSplitterStyle}"
                    ManipulationDelta="OnItemPaneSplitterDrag">
                <Border Width="1" HorizontalAlignment="Center"
                        Background="{ThemeResource CardStrokeColorDefaultBrush}" />
            </Border>

            <!-- Details -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Padding="12,12,12,8" Spacing="2">
                    <TextBlock x:Name="DetailTitle" Style="{StaticResource PaneTitleStyle}"
                               TextWrapping="Wrap" Text="{x:Bind T('X509_DetailsTitle')}" />
                    <TextBlock x:Name="DetailStatusText" FontSize="12" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <ScrollViewer Grid.Row="1" Padding="12,0,12,12" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="DetailPanel" Spacing="4" />
                </ScrollViewer>

                <StackPanel x:Name="DetailEmptyState" Grid.Row="1" HorizontalAlignment="Center"
                            VerticalAlignment="Center" Spacing="8" MaxWidth="280" IsHitTestVisible="False">
                    <FontIcon Glyph="&#xE946;" FontSize="28"
                              Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <TextBlock Text="{x:Bind T('X509_DetailsEmptyHint')}" TextWrapping="Wrap"
                               TextAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Page>
