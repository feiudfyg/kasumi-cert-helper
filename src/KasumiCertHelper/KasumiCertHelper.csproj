<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>KasumiCertHelper</RootNamespace>
    <AssemblyName>KasumiCertHelper</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <EnableMsixTooling>false</EnableMsixTooling>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>false</SelfContained>
    <PublishTrimmed>False</PublishTrimmed>
    <PublishReadyToRun>False</PublishReadyToRun>
    <EnableDefaultPageItems>true</EnableDefaultPageItems>

    <!--
      Only the runtime resources the interface actually uses are shipped. The
      Microsoft.WindowsAppSDK metapackage would also pull in Widgets, AI and ML (onnxruntime +
      DirectML, about 41 MB) which this application never touches.
    -->
    <SatelliteResourceLanguages>en;zh-Hans</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="1.8.260803003" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Runtime" Version="1.8.260921001" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.4654" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\KasumiCertHelper.Core\KasumiCertHelper.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <!--
    A distributed binary has to carry the license text and the notices of the libraries it uses
    (GPLv3, and the MIT notice of BouncyCastle and CommunityToolkit).
  -->
  <ItemGroup>
    <None Include="..\..\LICENSE" Link="LICENSE"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\THIRD-PARTY-NOTICES.md" Link="THIRD-PARTY-NOTICES.md"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    The Windows App SDK runtime package carries the Windows ML payload (onnxruntime, DirectML and
    the Microsoft.Windows.AI projections) although this application never calls into it. It is
    removed from the published output only, so day to day builds keep everything the framework
    might probe for.
  -->
  <Target Name="RemoveUnusedWindowsMlPayload" AfterTargets="Publish">
    <ItemGroup>
      <UnusedWindowsMlFile Include="$(PublishDir)onnxruntime.dll" />
      <UnusedWindowsMlFile Include="$(PublishDir)onnxruntime_providers_shared.dll" />
      <UnusedWindowsMlFile Include="$(PublishDir)DirectML.dll" />
      <UnusedWindowsMlFile Include="$(PublishDir)Microsoft.ML.OnnxRuntime.dll" />
      <UnusedWindowsMlFile Include="$(PublishDir)Microsoft.Windows.AI.*.dll" />
      <UnusedWindowsMlFile Include="$(PublishDir)Microsoft.Windows.AI.*.winmd" />
    </ItemGroup>
    <Delete Files="@(UnusedWindowsMlFile)" ContinueOnError="true" />
    <RemoveDir Directories="$(PublishDir)NpuDetect" ContinueOnError="true" />
    <Message Importance="normal"
             Text="Removed the unused Windows ML payload from $(PublishDir)" />
  </Target>

  <!--
    The compiled XAML and the resource index live in <AssemblyName>.pri. With Msix tooling turned
    off nothing adds it to the publish output, and the application then fails at startup with
    "XAML parsing failed", so it is copied next to the executable explicitly.
  -->
  <Target Name="IncludeAppPriInPublish" AfterTargets="Publish">
    <Copy SourceFiles="$(OutDir)$(AssemblyName).pri"
          DestinationFolder="$(PublishDir)"
          SkipUnchangedFiles="true"
          Condition="Exists('$(OutDir)$(AssemblyName).pri')" />
    <Error Text="Could not find $(OutDir)$(AssemblyName).pri, the published application would fail to load XAML."
           Condition="!Exists('$(PublishDir)$(AssemblyName).pri')" />
  </Target>

</Project>
